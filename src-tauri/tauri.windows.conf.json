{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"bundle": {
		"targets": ["nsis"],
		"windows": {
			"webviewInstallMode": {
				"type": "downloadBootstrapper",
				"silent": true
			},
			"nsis": {
				"installMode": "currentUser",
				"languages": ["PortugueseBR", "English"],
				"displayLanguageSelector": false,
				"compression": "lzma"
			}
		}
	}
}
